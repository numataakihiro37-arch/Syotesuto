<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>市民革命 演習所 | 世界史 確認テスト</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;700&family=Zen+Old+Mincho:wght@500;700;900&family=Courier+Prime&display=swap" rel="stylesheet">
<style>
:root {
  --paper:        #E8E2D0;
  --paper-dark:   #DCD3B8;
  --paper-edge:   #CBBF9C;
  --ink:          #2B2118;
  --ink-soft:     #5B4F3F;
  --correct:      #2A4D69;
  --correct-deep: #16314A;
  --wrong:        #9B2226;
  --gold:         #9C7A23;

  --font-display: 'Zen Old Mincho', serif;
  --font-body:    'Shippori Mincho', serif;
  --font-data:    'Courier Prime', monospace;
  --radius: 2px;
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  padding: 0;
  background: var(--paper-edge);
  color: var(--ink);
  font-family: var(--font-body);
}

body {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  padding: 28px 14px 60px;
  background-image:
    repeating-linear-gradient(0deg, rgba(0,0,0,0.015) 0px, rgba(0,0,0,0.015) 1px, transparent 1px, transparent 3px);
}

.board {
  width: 100%;
  max-width: 680px;
  background: var(--paper);
  border: 1px solid var(--paper-edge);
  box-shadow:
    0 1px 0 rgba(255,255,255,0.4) inset,
    0 18px 40px -20px rgba(43, 33, 24, 0.45);
  position: relative;
}

.board::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(ellipse at top left, rgba(43,33,24,0.10), transparent 55%),
    radial-gradient(ellipse at bottom right, rgba(43,33,24,0.10), transparent 55%);
}

.letterhead {
  text-align: center;
  padding: 36px 24px 26px;
  border-bottom: 3px double var(--ink);
}
.letterhead__eyebrow {
  font-family: var(--font-data);
  font-size: 11px;
  letter-spacing: 0.12em;
  color: var(--ink-soft);
  text-transform: uppercase;
  margin-bottom: 10px;
}
.letterhead__title {
  font-family: var(--font-display);
  font-weight: 900;
  font-size: clamp(28px, 6vw, 38px);
  letter-spacing: 0.06em;
  margin: 0;
  line-height: 1.3;
}
.letterhead__sub {
  margin-top: 8px;
  font-size: 13px;
  color: var(--ink-soft);
  letter-spacing: 0.04em;
}

.tally {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 18px;
  padding: 18px 28px;
  border-bottom: 1px solid var(--paper-edge);
  font-family: var(--font-data);
  font-size: 13px;
}
.tally__group { display: flex; align-items: baseline; gap: 8px; }
.tally__label { color: var(--ink-soft); font-size: 12px; }
.tally__marks { letter-spacing: 3px; font-size: 15px; min-width: 14px; display: inline-block; }
.tally__marks--correct-color { color: var(--correct); }
.tally__marks--wrong-color { color: var(--wrong); }
.tally__count { margin-left: auto; color: var(--ink-soft); font-size: 12px; }

.docket { padding: 38px 28px 30px; min-height: 280px; }
.docket__number {
  font-family: var(--font-data);
  font-size: 13px;
  color: var(--gold);
  letter-spacing: 0.1em;
  margin-bottom: 14px;
}
.docket__question {
  font-family: var(--font-display);
  font-size: clamp(18px, 4vw, 22px);
  line-height: 1.75;
  margin: 0 0 30px;
  font-weight: 500;
}
.docket__form { display: flex; gap: 10px; flex-wrap: wrap; }
.docket__input {
  flex: 1 1 220px;
  font-family: var(--font-body);
  font-size: 16px;
  padding: 12px 14px;
  border: 1px solid var(--ink-soft);
  background: #fdfcf6;
  color: var(--ink);
  border-radius: var(--radius);
}
.docket__input:focus {
  outline: none;
  border-color: var(--gold);
  box-shadow: 0 0 0 3px rgba(156, 122, 35, 0.18);
}

.btn {
  font-family: var(--font-data);
  font-size: 13px;
  letter-spacing: 0.06em;
  padding: 12px 22px;
  border: 1px solid var(--ink);
  background: transparent;
  color: var(--ink);
  cursor: pointer;
  border-radius: var(--radius);
  transition: transform 0.12s ease, background 0.15s ease, color 0.15s ease;
}
.btn:hover { transform: translateY(-1px); }
.btn:active { transform: translateY(0); }
.btn:focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }
.btn--primary { background: var(--ink); color: var(--paper); }
.btn--primary:hover { background: var(--correct-deep); }
.btn--ghost { background: transparent; }
.btn--ghost:hover { background: rgba(43,33,24,0.06); }

.verdict { margin-top: 26px; display: none; align-items: center; gap: 18px; flex-wrap: wrap; }
.verdict.is-visible { display: flex; }

.stamp {
  font-family: var(--font-display);
  font-weight: 900;
  font-size: 22px;
  letter-spacing: 0.08em;
  padding: 10px 18px;
  border: 3px solid currentColor;
  border-radius: 6px;
  transform: rotate(-7deg) scale(0.5);
  opacity: 0;
  position: relative;
  white-space: nowrap;
}
.stamp::after {
  content: "";
  position: absolute;
  inset: -6px;
  border: 1px solid currentColor;
  border-radius: 8px;
  opacity: 0.35;
  filter: blur(0.5px);
}
.stamp.is-correct { color: var(--correct); }
.stamp.is-wrong { color: var(--wrong); }
.stamp.animate { animation: stamp-slam 0.45s cubic-bezier(.2,1.4,.4,1) forwards; }
@keyframes stamp-slam {
  0%   { transform: rotate(-7deg) scale(2.2); opacity: 0; }
  60%  { transform: rotate(-7deg) scale(0.92); opacity: 1; }
  80%  { transform: rotate(-7deg) scale(1.05); }
  100% { transform: rotate(-7deg) scale(1); opacity: 1; }
}

.verdict__correct-answer { font-family: var(--font-body); font-size: 14px; color: var(--ink-soft); margin: 0; }
.verdict__correct-answer .label { color: var(--ink); font-weight: 700; }

.results { padding: 40px 28px 30px; }
.results__title {
  font-family: var(--font-display);
  font-size: 26px;
  text-align: center;
  margin: 0 0 6px;
  border-bottom: 3px double var(--ink);
  padding-bottom: 18px;
}
.results__score {
  text-align: center;
  font-family: var(--font-data);
  font-size: 15px;
  color: var(--ink-soft);
  margin: 18px 0 26px;
}
.results__list { display: flex; flex-direction: column; gap: 10px; margin-bottom: 30px; }
.result-item {
  border: 1px solid var(--paper-edge);
  background: var(--paper-dark);
  padding: 12px 14px;
  border-radius: var(--radius);
  font-size: 14px;
  line-height: 1.6;
}
.result-item__q { color: var(--ink-soft); margin: 0 0 4px; }
.result-item__a { margin: 0; font-weight: 700; }
.result-item--wrong { border-left: 4px solid var(--wrong); }
.result-item--correct { border-left: 4px solid var(--correct); }
.results__actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }

.seal-footer {
  text-align: center;
  padding: 16px;
  font-family: var(--font-data);
  font-size: 11px;
  color: var(--ink-soft);
  letter-spacing: 0.08em;
  border-top: 1px solid var(--paper-edge);
}

@media (max-width: 480px) {
  .letterhead { padding: 28px 16px 20px; }
  .docket { padding: 28px 18px 24px; }
  .tally { padding: 14px 18px; font-size: 12px; gap: 12px; }
  .docket__form { flex-direction: column; }
  .docket__form .btn { width: 100%; }
}

@media (prefers-reduced-motion: reduce) {
  .stamp.animate { animation: none; opacity: 1; transform: rotate(-7deg) scale(1); }
  .btn { transition: none; }
}
</style>
</head>
<body>

<div class="board">

  <header class="letterhead">
    <div class="letterhead__eyebrow">WORLD HISTORY ARCHIVE — 議事録 第2号</div>
    <h1 class="letterhead__title">市民革命　演習所</h1>
    <div class="letterhead__sub">フランス革命 ・ アメリカ独立革命 ・ 南北戦争</div>
  </header>

  <main class="chamber" id="chamber">

    <div class="tally" id="tally" aria-live="polite">
      <div class="tally__group">
        <span class="tally__label">正解</span>
        <span class="tally__marks" id="tally-correct"></span>
      </div>
      <div class="tally__group">
        <span class="tally__label">不正解</span>
        <span class="tally__marks" id="tally-wrong"></span>
      </div>
      <div class="tally__count" id="tally-progress">第 1 条 / 全 20 条</div>
    </div>

    <section class="docket" id="docket">
      <div class="docket__number" id="article-number">第１条</div>
      <p class="docket__question" id="question-text">問題文がここに表示されます</p>

      <form class="docket__form" id="answer-form" autocomplete="off">
        <input
          type="text"
          id="answer-input"
          class="docket__input"
          placeholder="解答を記入……"
          aria-label="解答入力欄"
        >
        <button type="submit" class="btn btn--primary" id="submit-btn">回答する</button>
      </form>

      <div class="verdict" id="verdict" aria-live="assertive">
        <div class="stamp" id="stamp"></div>
        <p class="verdict__correct-answer" id="correct-answer-text"></p>
        <button class="btn btn--ghost" id="next-btn">次の条文へ →</button>
      </div>
    </section>

  </main>

  <section class="results" id="results" hidden>
    <h2 class="results__title">決議結果</h2>
    <p class="results__score" id="results-score"></p>
    <div class="results__list" id="results-list"></div>
    <div class="results__actions">
      <button class="btn btn--primary" id="retry-all-btn">もう一度（全問）</button>
      <button class="btn btn--ghost" id="retry-wrong-btn">不正解のみ再挑戦</button>
    </div>
  </section>

  <footer class="seal-footer">
    <span>個別指導　学習用演習サイト</span>
  </footer>

</div>

<script>
// ===================================================================
// 問題データ（ここを書き換えれば別範囲の問題にも流用可）
// ===================================================================
const QUESTIONS = [
  { q: "特権身分への課税をめぐって召集され、フランス革命の発端となった会議は?", answers: ["三部会"] },
  { q: "上の会議の中で第三身分が結成し、憲法制定まで解散しないと誓った会合は?", answers: ["テニスコートの誓い"] },
  { q: "1789年、パリ民衆が起こした、革命勃発の契機となった襲撃事件は?", answers: ["バスティーユ牢獄襲撃", "バスティーユ襲撃"] },
  { q: "1789年8月、自然権・国民主権・私有財産の不可侵などを定めた全17条の宣言は?", answers: ["人権宣言", "人間および市民の権利の宣言"] },
  { q: "ロベスピエール主導のジャコバン派独裁のもとで行われた、王妃処刑などに見られる政治は?", answers: ["恐怖政治"] },
  { q: "恐怖政治への反発から1794年にロベスピエールが逮捕・処刑された反動を何というか?", answers: ["テルミドールの反動", "テルミドール9日のクーデタ"] },
  { q: "5人の総裁による権力分担を特徴とした、1795年に成立した政府は?", answers: ["総裁政府"] },
  { q: "1773年、茶の独占販売権に反発し、市民が東インド会社船を急襲した事件は?", answers: ["ボストン茶会事件"] },
  { q: "1774年、フィラデルフィアで開かれ、通商断絶同盟を結成した会議は?", answers: ["第1回大陸会議", "第一回大陸会議"] },
  { q: "独立戦争に突入するきっかけとなった、最初の武力衝突は?", answers: ["レキシントンの戦い"] },
  { q: "1776年、フィラデルフィアでジェファソンが起草した文書は?", answers: ["独立宣言"] },
  { q: "1787年、強力な中央集権的な憲法を起案するために開かれた会議は?", answers: ["憲法制定会議"] },
  { q: "大統領・連邦議会・最高裁判所による三権分立を定めた、世界初の成文憲法は?", answers: ["アメリカ合衆国憲法", "合衆国憲法"] },
  { q: "1820年、北緯36度30分を境界に自由州と奴隷州を分けた取り決めは?", answers: ["ミズーリ協定"] },
  { q: "1854年、奴隷州の採用を州住民の選択に委ねた法律は?", answers: ["カンザス・ネブラスカ法", "カンザスネブラスカ法"] },
  { q: "1861年に大統領となり、南北戦争を指導した共和党の人物は?", answers: ["リンカン", "リンカーン"] },
  { q: "南部11州が結成した、南北戦争における南部側の国家は?", answers: ["アメリカ連合国"] },
  { q: "1862年、西部農民の支持を得るために制定された法律は?", answers: ["ホームステッド法", "自営農地法", "ホームステッド（自営農地）法"] },
  { q: "1863年、南部での奴隷の決起を期待して発布された宣言は?", answers: ["奴隷解放宣言"] },
  { q: "北軍勝利後、リンカンが「人民の、人民による、人民のための政治」と演説した戦いは?", answers: ["ゲティスバーグの戦い"] }
];

// ===================================================================
// アプリケーションロジック
// ===================================================================
(() => {
  "use strict";

  let queue = [];
  let currentIndex = 0;
  let correctCount = 0;
  let wrongCount = 0;
  let answered = false;
  let wrongIndices = [];
  let resultLog = [];

  const chamberEl = document.getElementById("chamber");
  const resultsEl = document.getElementById("results");
  const articleNumberEl = document.getElementById("article-number");
  const questionTextEl = document.getElementById("question-text");
  const answerFormEl = document.getElementById("answer-form");
  const answerInputEl = document.getElementById("answer-input");
  const submitBtn = document.getElementById("submit-btn");
  const verdictEl = document.getElementById("verdict");
  const stampEl = document.getElementById("stamp");
  const correctAnswerTextEl = document.getElementById("correct-answer-text");
  const nextBtn = document.getElementById("next-btn");
  const tallyCorrectEl = document.getElementById("tally-correct");
  const tallyWrongEl = document.getElementById("tally-wrong");
  const tallyProgressEl = document.getElementById("tally-progress");
  const resultsScoreEl = document.getElementById("results-score");
  const resultsListEl = document.getElementById("results-list");
  const retryAllBtn = document.getElementById("retry-all-btn");
  const retryWrongBtn = document.getElementById("retry-wrong-btn");

  function normalize(str) {
    return String(str)
      .trim()
      .replace(/[\s　]/g, "")
      .replace(/[（）()「」『』]/g, "")
      .replace(/・/g, "");
  }

  function isCorrectAnswer(userInput, question) {
    const normalizedInput = normalize(userInput);
    if (!normalizedInput) return false;
    return question.answers.some((ans) => normalize(ans) === normalizedInput);
  }

  function shuffle(arr) {
    const a = arr.slice();
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function toKanjiTally(count) {
    return "｜".repeat(count);
  }

  function startSession(indices) {
    queue = indices;
    currentIndex = 0;
    correctCount = 0;
    wrongCount = 0;
    wrongIndices = [];
    resultLog = [];
    resultsEl.hidden = true;
    chamberEl.hidden = false;
    renderTally();
    renderQuestion();
  }

  function init() {
    const allIndices = QUESTIONS.map((_, i) => i);
    startSession(shuffle(allIndices));
  }

  function renderQuestion() {
    answered = false;
    answerInputEl.value = "";
    answerInputEl.disabled = false;
    submitBtn.disabled = false;
    verdictEl.classList.remove("is-visible");
    stampEl.classList.remove("animate", "is-correct", "is-wrong");
    stampEl.textContent = "";

    const qIndex = queue[currentIndex];
    const q = QUESTIONS[qIndex];

    articleNumberEl.textContent = `第${currentIndex + 1}条`;
    questionTextEl.textContent = `…${q.q}`;
    tallyProgressEl.textContent = `第 ${currentIndex + 1} 条 / 全 ${queue.length} 条`;
    answerInputEl.focus();
  }

  function submitAnswer(e) {
    e.preventDefault();
    if (answered) return;

    const qIndex = queue[currentIndex];
    const q = QUESTIONS[qIndex];
    const userInput = answerInputEl.value;
    const correct = isCorrectAnswer(userInput, q);

    answered = true;
    answerInputEl.disabled = true;
    submitBtn.disabled = true;

    if (correct) {
      correctCount++;
    } else {
      wrongCount++;
      wrongIndices.push(qIndex);
    }
    resultLog.push({ qIndex, correct, userInput });

    showVerdict(correct, q);
    renderTally();
  }

  function showVerdict(correct, question) {
    verdictEl.classList.add("is-visible");
    stampEl.textContent = correct ? "正解" : "不正解";
    stampEl.classList.add(correct ? "is-correct" : "is-wrong");

    requestAnimationFrame(() => {
      stampEl.classList.add("animate");
    });

    correctAnswerTextEl.innerHTML = correct
      ? ""
      : `<span class="label">正答：</span>${question.answers[0]}`;

    nextBtn.textContent = currentIndex + 1 < queue.length ? "次の条文へ →" : "決議結果を見る →";
  }

  function renderTally() {
    tallyCorrectEl.innerHTML = `<span class="tally__marks--correct-color">${toKanjiTally(correctCount)}</span>`;
    tallyWrongEl.innerHTML = `<span class="tally__marks--wrong-color">${toKanjiTally(wrongCount)}</span>`;
  }

  function goNext() {
    if (currentIndex + 1 < queue.length) {
      currentIndex++;
      renderQuestion();
    } else {
      showResults();
    }
  }

  function showResults() {
    chamberEl.hidden = true;
    resultsEl.hidden = false;

    const total = queue.length;
    resultsScoreEl.textContent = `${correctCount} / ${total} 問　正解`;

    resultsListEl.innerHTML = "";
    resultLog.forEach((entry) => {
      const q = QUESTIONS[entry.qIndex];
      const div = document.createElement("div");
      div.className = `result-item ${entry.correct ? "result-item--correct" : "result-item--wrong"}`;
      div.innerHTML = `
        <p class="result-item__q">…${q.q}</p>
        <p class="result-item__a">${entry.correct ? "✓ 正解" : `✗ ${entry.userInput || "（無回答）"} → 正答：${q.answers[0]}`}</p>
      `;
      resultsListEl.appendChild(div);
    });

    retryWrongBtn.disabled = wrongIndices.length === 0;
    retryWrongBtn.style.opacity = wrongIndices.length === 0 ? "0.4" : "1";
  }

  answerFormEl.addEventListener("submit", submitAnswer);
  nextBtn.addEventListener("click", goNext);

  retryAllBtn.addEventListener("click", () => {
    startSession(shuffle(QUESTIONS.map((_, i) => i)));
  });

  retryWrongBtn.addEventListener("click", () => {
    if (wrongIndices.length === 0) return;
    startSession(shuffle(wrongIndices.slice()));
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Enter" && answered && verdictEl.classList.contains("is-visible")) {
      if (document.activeElement !== answerInputEl) {
        goNext();
      }
    }
  });

  init();
})();
</script>
</body>
</html>
